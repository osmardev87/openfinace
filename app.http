### ================================
### 🔐 1. FAZER LOGIN — Obter Token
### ================================
POST http://localhost:8089/auth/login
Content-Type: application/json

{
  "email": "osmar.gsilva1987@gmail.com",
  "senha": "123456789"
}

### ================================
### 👤 CRIAR USUÁRIO — Completo
### ROLE ( VENDEDOR, ADMIN )
### ================================
POST https://openfinace.onrender.com/auth/register
Content-Type: application/json

{
  "nome": "José Osmar",
  "email": "osmar.dev87@gmail.com",
  "senha": "Osmar4547*",
  "cpf": "12345678907",
  "cnpj": "12345678901234",
  "telefone": "87999998888",
  "role": "ADMIN"
}

### ================================
### 👤 CRIAR USUÁRIO — Cliente (sem senha/cpf/cnpj opcionais)
### ROLE (CLIENTE, FORNECEDOR)
### ================================
POST http://localhost:8089/auth/register
Content-Type: application/json

{
  "nome": "João Cliente",
  "email": "joao@email.com",
  "telefone": "87988887777",
  "cpf": "12345678909",
  "cnpj": "",
  "role": "ADMIN"
}




